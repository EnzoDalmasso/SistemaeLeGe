# Base de datos PostgreSQL (Neon en Vercel: usar la URL "pooled")
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require
# Clave para firmar las sesiones: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Contraseña inicial de los usuarios que crea npm run db:seed
SEED_PASSWORD=

# Telegram (demo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# IA compatible con OpenAI
#  Demo gratis (Groq):  AI_BASE_URL=https://api.groq.com/openai/v1  AI_TEXT_MODEL=llama-3.3-70b-versatile  AI_AUDIO_MODEL=whisper-large-v3-turbo
#  Producción (OpenAI): AI_BASE_URL=https://api.openai.com/v1       AI_TEXT_MODEL=gpt-4o-mini              AI_AUDIO_MODEL=gpt-4o-mini-transcribe
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_TEXT_MODEL=llama-3.3-70b-versatile
AI_AUDIO_MODEL=whisper-large-v3-turbo
